{
    "version": "0.2.0",
    "configurations": [
        {
            "type": "java",
            "name": "JUI CLI",
            "request": "launch",
            "mainClass": "it.jui.cli.JuiCLI",
            "projectName": "jui-core"
        },
        {
            "type": "java",
            "name": "Customer Example",
            "request": "launch",
            "mainClass": "it.jui.apps.customer.CustomerApp",
            "projectName": "jui-app-customer"
        },
        {
            "type": "java",
            "name": "Dashboard Example",
            "request": "launch",
            "mainClass": "it.jui.apps.dashboard.DashboardApp",
            "projectName": "jui-app-dashboard"
        },
        {
            "type": "java",
            "name": "Survey Example",
            "request": "launch",
            "mainClass": "it.jui.apps.survey.SurveyApp",
            "projectName": "jui-app-survey"
        },
        {
            "type": "java",
            "name": "Map Example",
            "request": "launch",
            "mainClass": "it.jui.apps.map.MapApp",
            "projectName": "jui-app-map"
        },
        {
            "type": "java",
            "name": "Media Example",
            "request": "launch",
            "mainClass": "it.jui.apps.media.MediaApp",
            "projectName": "jui-app-media"
        },
        {
            "type": "java",
            "name": "Current File",
            "request": "launch",
            "mainClass": "${file}"
        }
    ]
}
